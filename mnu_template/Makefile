# Template for a core's menu module. Copy this folder into the core's
# repository as menu/, rename example.cpp, set MNU_NAME and point MAIN_MISTER
# at a Main_MiSTer checkout. See mnu_module.mk for the targets and knobs.
MNU_NAME     = example
MAIN_MISTER ?= $(abspath ..)
MNU_SD_DIR  ?= /media/fat
include $(MAIN_MISTER)/mnu_module.mk
